{
	"schemaVersion": 1,
	"id": "meggo",
	"version": "${version}",
	"name": "Meggo",
	"description": "A Fabric, client-side mod for miscellaneous commands.",
	"authors": [
		"Evan Abbott"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
